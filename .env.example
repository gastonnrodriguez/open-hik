# Copy this file to .env and fill in your DVR details.

# IP or hostname of your Hikvision DVR/NVR
DVR_HOST=192.168.1.2

# Credentials of a DVR user (a read-only "operator" user is recommended
# over admin). URL-encode special characters in the password (@ -> %40).
DVR_USER=admin
DVR_PASS=changeme

# Optional. URL where the BROWSER can reach go2rtc. Leave empty to use
# the default: same host as the web page, port 1984. Only set this when
# running behind a reverse proxy or a non-standard network setup.
GO2RTC_PUBLIC_URL=
